{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocSnap",
  "version": "0.1.0",
  "identifier": "app.docsnap.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter docsnap-desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter docsnap-desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocSnap",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$APPDATA/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$PICTURE/**",
          "$DESKTOP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": ["../src-tauri/resources/**/*"],
    "externalBin": [],
    "windows": {
      "wix": { "language": "en-US" }
    }
  },
  "plugins": {}
}
